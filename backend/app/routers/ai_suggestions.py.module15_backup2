
from datetime import date, timedelta

from fastapi import APIRouter, Depends
from sqlalchemy.orm import Session

from app.database import get_db
from app.dependencies import get_current_user
from app.models import Workout, Goal, Exercise
from app.routers.streaks import calculate_current_streak


router = APIRouter(
    prefix="/ai-suggestions",
    tags=["AI Workout Suggestions"]
)


# =====================================
# MODULE 15: AI WORKOUT SUGGESTIONS
# Rule-based personalized recommendation engine
# =====================================

@router.get("/")
def get_ai_workout_suggestions(
    db: Session = Depends(get_db),
    current_user=Depends(get_current_user)
):

    today = date.today()
    thirty_days_ago = today - timedelta(days=30)

    # 1. FETCH USER WORKOUT HISTORY

    workouts = (
        db.query(Workout)
        .filter(
            Workout.user_id == current_user.id,
            Workout.workout_date >= thirty_days_ago,
            Workout.workout_date <= today
        )
        .all()
    )

    category_counts = {
        "Cardio": 0,
        "Strength": 0,
        "Yoga": 0
    }

    for workout in workouts:
        if workout.category in category_counts:
            category_counts[workout.category] += 1

    # 2. FETCH USER GOALS

    goals = (
        db.query(Goal)
        .filter(Goal.user_id == current_user.id)
        .all()
    )

    active_goals = []

    goal_category_mapping = {
        "Weight Loss": "Cardio",
        "Muscle Gain": "Strength",
        "Steps": "Cardio"
    }

    for goal in goals:

        if goal.goal_type == "Weight Loss":
            completed = (
                goal.current_value <= goal.target_value
            )
        else:
            completed = (
                goal.current_value >= goal.target_value
            )

        if not completed:
            active_goals.append(goal)

    # 3. CALCULATE CURRENT STREAK

    workout_dates = [
        row[0]
        for row in (
            db.query(Workout.workout_date)
            .filter(
                Workout.user_id == current_user.id,
                Workout.workout_date <= today
            )
            .distinct()
            .order_by(Workout.workout_date.asc())
            .all()
        )
    ]

    current_streak = calculate_current_streak(
        workout_dates,
        today
    )

    # 4. CALCULATE CATEGORY SCORES

    category_scores = {
        "Cardio": 0,
        "Strength": 0,
        "Yoga": 0
    }

    category_reasons = {
        "Cardio": [],
        "Strength": [],
        "Yoga": []
    }

    # Goal-based prioritization

    for goal in active_goals:

        category = goal_category_mapping.get(
            goal.goal_type
        )

        if category:

            category_scores[category] += 5

            reason = (
                f"Supports your active {goal.goal_type} goal"
            )

            if reason not in category_reasons[category]:
                category_reasons[category].append(reason)

    # Workout-history personalization

    for category, count in category_counts.items():

        if count > 0:

            category_scores[category] += min(count, 3)

            category_reasons[category].append(
                f"You performed {category} workouts "
                f"{count} time(s) in the last 30 days"
            )

    # Consistency-based recommendations

    if current_streak == 0:

        category_scores["Yoga"] += 3

        category_reasons["Yoga"].append(
            "A gentle session can help you restart your routine"
        )

    elif current_streak >= 7:

        category_scores["Strength"] += 2

        category_reasons["Strength"].append(
            "Your consistent workout streak supports "
            "progressive training"
        )

    else:

        category_scores["Yoga"] += 1

        category_reasons["Yoga"].append(
            "Include recovery and flexibility in your routine"
        )

    # 5. FETCH EXERCISES FROM EXISTING LIBRARY

    exercises = (
        db.query(Exercise)
        .order_by(Exercise.name.asc())
        .all()
    )

    # Rank categories by recommendation score

    ranked_categories = sorted(
        category_scores.keys(),
        key=lambda category: (
            category_scores[category],
            category
        ),
        reverse=True
    )

    # Recommend actual exercises from the database

    recommendations = []

    for category in ranked_categories:

        category_exercises = [
            exercise
            for exercise in exercises
            if exercise.category == category
        ]

        for exercise in category_exercises:

            reasons = category_reasons[category].copy()

            if not reasons:
                reasons.append(
                    f"Recommended to help maintain a "
                    f"balanced fitness routine"
                )

            recommendations.append({
                "exercise_id": exercise.id,
                "name": exercise.name,
                "category": exercise.category,
                "description": exercise.description,
                "duration": exercise.duration,
                "recommendation_score": category_scores[category],
                "reasons": reasons
            })

            if len(recommendations) >= 5:
                break

        if len(recommendations) >= 5:
            break

    # 6. RETURN PERSONALIZED RESULTS

    return {
        "message": "Personalized workout suggestions generated successfully",
        "recommendation_type": "Rule-Based Personalization",
        "user_id": current_user.id,
        "current_streak": current_streak,
        "workout_history": {
            "period_days": 30,
            "total_workouts": len(workouts),
            "category_counts": category_counts
        },
        "active_goals": [
            {
                "goal_type": goal.goal_type,
                "current_value": goal.current_value,
                "target_value": goal.target_value,
                "deadline": goal.deadline
            }
            for goal in active_goals
        ],
        "category_scores": category_scores,
        "recommendations": recommendations,
        "total_recommendations": len(recommendations)
    }

